{
    "name": "kyrgyz-calendar-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "check:responsive": "node scripts/check-responsive.cjs",
        "dev:mobile": "vite --mode mobile --host 127.0.0.1 --port 5178",
        "build:mobile": "tsc --noEmit --incremental false && vite build --mode mobile",
        "android:sync": "npm run build:mobile && cap sync android",
        "android:open": "cap open android",
        "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
        "test": "node --test src/mobile/*.test.mjs src/features/calendar/utils/*.test.mjs src/features/calendar/components/*.test.mjs"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.3",
        "@capacitor/app": "^8.1.2",
        "@capacitor/core": "^8.5.3",
        "@capacitor/geolocation": "^8.2.4",
        "@fontsource/cormorant-garamond": "^5.2.11",
        "@fontsource/lora": "^5.2.8",
        "@tanstack/react-query": "^5.50.0",
        "axios": "^1.7.0",
        "date-fns": "^3.6.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "suncalc": "2.1.1",
        "zustand": "^4.5.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.3",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.0",
        "typescript": "^5.5.0",
        "vite": "^7.3.2",
        "vite-plugin-pwa": "^1.2.0"
    },
    "overrides": {
        "serialize-javascript": "7.0.5"
    }
}
